# ==============================================================================
# FinSight AI - Git Ignore Specification (GitHub Enterprise Standard)
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python distribution & eggs
*.egg-info/
dist/
build/
eggs/
parts/
bin/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/
.coverage.*

# Jupyter Checkpoints & Notebook Autosaves
.ipynb_checkpoints/
*-checkpoint.ipynb

# Virtual Environments
.venv/
venv/
ENV/
env/
conda-env/

# OS / IDE Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Temporary Scratch Scripts
scratch/
temp/
tmp/
catboost_info/
**/catboost_info/

# ==============================================================================
# Large Raw E-Commerce Datasets (Exceeding GitHub 100MB Limit)
# Note: Cleaned, validated, and compressed Parquet artifacts under data/processed/
# are fully tracked and versioned for instant reproducibility.
# ==============================================================================
jd_retail/
olist/
online+retail/
data/raw/
*.csv
!results/*.csv
*.xlsx
*.zip
*.tar.gz
*.7z
